{
  "_meta": {
    "note": "建物マスターデータ。共通25 + 付属物2 + 文明固有8 = 35件（_meta は件数に含めない）。上流資料: docs/03_文明と進化.html §3 / docs/07_ゲームシステム.html §9",
    "costSource": "コストは 03§3 の表から完全転記（文明ボーナスによる変動は civs.json 側で倍率として適用する）。資料にコストが書かれていない文明固有建物は下記 costRuleForCivOnly に従って決めた",
    "numberRules": {
      "buildSec": "資料に無いため規則で算出: 総コスト（全資源の合計）÷ 5.5 を 5 秒単位に丸め、最小 3 秒・最大 180 秒。例) 町の中心 500÷5.5=90.9→90 / 城 650÷5.5=118→120 / 碑の写し 3000÷5.5=545→上限 180",
      "hp": "役割別の基準値。壁1枚 300 / 家 450 / 農地 300 / 資源搬入所 600 / 生産・研究小屋 1200 / 市場・港・学舎級 1500 / 桟橋 900 / 町の中心 2400 / 城 4200 / 記念碑 3000。門は同素材の壁の 2 倍（木門 600 / 城門 1800）。石造は木造の 3 倍（石壁 900）。塔 1000 / 砲塔 1500。大天幕は城の 60%（4200×0.6=2520、07§9 の明記）",
      "sizeTiles": "壁・柵・塔・砲塔 1x1、門 2x1、小屋・家 2x2、生産・研究・農地・桟橋・港 3x3、町の中心・市場・城 4x4、記念碑 3x3、付属物 1x1、街道 1x1（線で引ける）",
      "sightTiles": "基準 6。壁・門 3、家・農地 4、付属物 2、街道 2、町の中心・城・大天幕 8、見張り小屋・見張り塔・砲塔 10、櫓 12（射程が長い分だけ広い）。学舎の『測量』で +4 される側の基準値",
      "attack": "資料に無いため塔系のみ設定: 見張り塔 12/射程8/2.0秒、櫓 12/射程10/2.0秒（射程が長い）、砲塔 18/射程10/3.0秒、城 25/射程9/2.0秒、大天幕 20/射程9/2.0秒",
      "garrisonCapacity": "見張り塔・砲塔 5（村人のみ）、櫓 5（兵も収容可・03§3）、町の中心 10、城 15、大天幕 15。garrisonAllows で収容できる種別を表す"
    },
    "costRuleForCivOnly": "03§3 にコストが書かれていない固有建物は同格の共通建物に合わせた: 街道 木5/1枚（木柵 木2 の 2.5 倍・敷設物）/ 塩蔵 木150（鍛冶場相当）/ 神殿基壇 石200（石材で建てる・03§3）/ 地下水路 木100（採掘場相当）/ 大天幕 木400石250（合計 650 = 城と同額だが遊牧民らしく木主体）",
    "keys": {
      "producesLines": "その文明のどの系統（line ID）を生産できるかを表す。兵舎・射場・厩・攻城工房・火薬工房・城は文明ごとに出る兵が違うため、unit ID を直書きせず line で表し units.json の civ+line で解決する（コードに文明名の分岐を書かせないため）",
      "produces": "文明に依存しない unit ID の配列",
      "producesRoles": "producesLines をさらに role で絞る（火薬工房は line=ranged/siege のうち role=gunpowder のみ）",
      "maxCount": "1 プレイヤーが同時に持てる上限（市場 1・碑の写し 1。塩蔵の buildingLimitOverride で上書きされる）",
      "garrisonAllows": "収容できる種別。villager / military",
      "buildable": "false ならプレイヤーは建てられない（付属物）",
      "autoTargetable": "false なら『略奪』などの令の自動ターゲットに入れない（手動選択時のみ攻撃可）",
      "onDestroyEffects": "破壊されたときに発生する効果（付属物の掟違反ペナルティ）",
      "lawViolationOnDestroy": "掟 ID。破壊すると忠誠度 −25%（07§10）",
      "effects": "存在するだけで効果を発揮するもの。型で表現し、コード側は type で分岐する"
    },
    "effectTypes": "効果型の登録簿は techs.json:_meta.effectTypes に統合した（二重管理を避けるため）。ここで使う型もすべてそちらに登録されている。",
    "techPlacementNote": "文明固有の研究 8 件（tanren/guntan/kayakujutsu/kyousen/shahou/menkou/kangyo/ekiden）は所属建物が 03§9 に明記されていないため、ここでは researches に入れず civs.json 側（T-M1-08）で解決する。犂・輪作は 03§9 で『町の中心 / 農地』とあるため町の中心に置いた"
  },
